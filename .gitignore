# RSP optimizer sources and compact validation record; keep generated ROMs,
# binaries, captures, dependency installs, build trees and raw logs local.
!benchmarks/rsp-optimizer/
benchmarks/rsp-optimizer/*
!benchmarks/rsp-optimizer/*.py
!benchmarks/rsp-optimizer/*.cpp
!benchmarks/rsp-optimizer/*.c
!benchmarks/rsp-optimizer/*.mk
!benchmarks/rsp-optimizer/*.md
!benchmarks/rsp-optimizer/n64-input.csv
!benchmarks/rsp-optimizer/validation.json

# CPU optimizer checks and reproducible benchmark drivers.
!benchmarks/cpu-optimizer/
benchmarks/cpu-optimizer/*
!benchmarks/cpu-optimizer/*.py
!benchmarks/cpu-optimizer/*.c
!benchmarks/cpu-optimizer/*.inc
!benchmarks/cpu-optimizer/*.mk
!benchmarks/cpu-optimizer/*.md
!benchmarks/cpu-optimizer/n64-input.csv
!benchmarks/cpu-optimizer/validation.json

# Conker workload profiling, optimization checks, and compact results.
!benchmarks/conker-optimizer/
benchmarks/conker-optimizer/*
