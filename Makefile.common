CORE_DIR           = $(ROOT_DIR)
LIBRETRO_COMM_DIR  = $(ROOT_DIR)/deps/libretro-common
RSPDIR_PARALLEL    =  $(CORE_DIR)/src/device/rcp/rsp/p_rsp

DYNAREC_USED := 0

# Native emitters and the portable engine share the precise CPU frontend.
ifeq ($(CPU_BACKEND),auto)
ifeq ($(WITH_DYNAREC),x86_64)
    DYNAREC_USED := 1
    COREFLAGS += -DHAVE_PARALLAXJIT
    PARALLAXJIT_DIR = $(CORE_DIR)/src/device/r4300/jit
    PARALLAXJIT_SOURCE = $(PARALLAXJIT_DIR)/parallaxjit_x64.cpp
    INCFLAGS += -I$(ROOT_DIR)/deps/xbyak
else ifeq ($(WITH_DYNAREC),x86)
    DYNAREC_USED := 1
    COREFLAGS += -DHAVE_PARALLAXJIT
    PARALLAXJIT_DIR = $(CORE_DIR)/src/device/r4300/jit
    PARALLAXJIT_SOURCE = $(PARALLAXJIT_DIR)/parallaxjit_x86.cpp
    INCFLAGS += -I$(ROOT_DIR)/deps/xbyak
else ifeq ($(WITH_DYNAREC),arm)
ifneq (,$(filter -DOS_LINUX,$(COREFLAGS)))
    DYNAREC_USED := 1
    COREFLAGS += -DHAVE_PARALLAXJIT
    PARALLAXJIT_DIR = $(CORE_DIR)/src/device/r4300/jit
    PARALLAXJIT_SOURCE = $(PARALLAXJIT_DIR)/parallaxjit_arm32.cpp
endif
else ifeq ($(WITH_DYNAREC),aarch64)
ifneq (,$(filter -DOS_LINUX,$(COREFLAGS)))
    DYNAREC_USED := 1
    COREFLAGS += -DHAVE_PARALLAXJIT
    PARALLAXJIT_DIR = $(CORE_DIR)/src/device/r4300/jit
    PARALLAXJIT_SOURCE = $(PARALLAXJIT_DIR)/parallaxjit_arm64.cpp $(ROOT_DIR)/deps/xbyak_aarch64/src/xbyak_aarch64_impl.cpp
    INCFLAGS += -I$(ROOT_DIR)/deps/xbyak_aarch64 -I$(ROOT_DIR)/deps/xbyak_aarch64/xbyak_aarch64
endif
endif
endif

ifeq ($(DYNAREC_USED),0)
COREFLAGS += -DPARALLAX_CPU_INTERPRETER
endif

INCFLAGS += \
	-I$(ROOT_DIR)/deps \
	-I$(ROOT_DIR)/custom \
	-I$(ROOT_DIR)/custom/osal \
	-I$(CORE_DIR)/src \
	-I$(LIBRETRO_COMM_DIR)/include \
	-I$(CORE_DIR)/src/device/rcp/rdp

ifeq ($(USF),1)
SOURCES_USF = $(CORE_DIR)/src/usf/usf.cpp $(CORE_DIR)/src/usf/pj64_state.c
endif

ifneq (,$(findstring win,$(platform)))
	INCFLAGS += -I$(ROOT_DIR)/deps/mman
endif

SOURCES_C = \
	$(CORE_DIR)/src/core/lifecycle.c \
	$(CORE_DIR)/src/core/file.c \
	$(CORE_DIR)/src/core/log.c \
	$(CORE_DIR)/src/core/controller.c \
	$(CORE_DIR)/src/core/clock.c \
	$(CORE_DIR)/src/core/storage.c \
	$(CORE_DIR)/src/device/cart.c \
	$(CORE_DIR)/src/device/controllers.c \
	$(CORE_DIR)/src/device/dd_controller.c \
	$(CORE_DIR)/src/device/disk.c \
	$(CORE_DIR)/src/device/device.c \
	$(CORE_DIR)/src/device/gb.c \
	$(CORE_DIR)/src/device/memory.c \
	$(CORE_DIR)/src/device/pif.c \
	$(CORE_DIR)/src/device/r4300/cp0.c \
	$(CORE_DIR)/src/device/r4300/jit_runtime.c \
	$(CORE_DIR)/src/device/r4300/cp1.c \
	$(CORE_DIR)/src/device/r4300/fpu_native.c \
	$(CORE_DIR)/src/device/r4300/idec.c \
	$(CORE_DIR)/src/device/r4300/interrupt.c \
	$(CORE_DIR)/src/device/r4300/cpu_ops.c \
	$(CORE_DIR)/src/device/r4300/r4300_core.c \
	$(CORE_DIR)/src/device/r4300/tlb.c \
	$(CORE_DIR)/src/device/rcp/rcp.c \
	$(CORE_DIR)/src/device/rcp/rsp/rsp_core.c \
	$(CORE_DIR)/src/device/rcp/rsp/rsp_dma_memory.c \
	$(CORE_DIR)/src/device/rdram.c \
	$(CORE_DIR)/src/main/main.c \
	$(CORE_DIR)/src/main/savestates.c \
	$(CORE_DIR)/src/main/util.c \
	$(CORE_DIR)/src/main/rom.c \
	$(CORE_DIR)/src/core/backend.c 


SOFTRDP_DIR = $(CORE_DIR)/src/device/rcp/rdp/softrdp
RSP_HLE_DIR = $(CORE_DIR)/src/device/rcp/rsp/hle
SOURCES_C += $(wildcard $(RSP_HLE_DIR)/*.c) \
             $(CORE_DIR)/src/device/rcp/rsp/optional_rsp.c
SOURCES_C += $(LIBRETRO_COMM_DIR)/encodings/encoding_crc32.c
SOURCES_C += $(CORE_DIR)/src/renderer_options.c
ifeq ($(USF),1)
# Audio decoders contain no RDP renderer, display-list walker, framebuffer
# protection, presentation code, renderer worker pool or image/video decoder.
SOURCES_C := $(filter-out $(RSP_HLE_DIR)/rdp_emit%.c $(addprefix $(RSP_HLE_DIR)/,jpeg.c hvqm.c re2.c),$(SOURCES_C))
SOURCES_C += $(CORE_DIR)/src/usf/rdp_stubs.c
else
SOURCES_C += $(addprefix $(CORE_DIR)/src/device/rcp/rdp/,fb.c rdp_core.c rdp_hle_fifo.c) \
             $(CORE_DIR)/src/device/rcp/rdp/performance_cores.c
SOURCES_C += $(SOFTRDP_DIR)/worker_pool.c \
             $(SOFTRDP_DIR)/presenter.c \
             $(LIBRETRO_COMM_DIR)/rthreads/rthreads.c
include $(CORE_DIR)/src/device/rcp/rdp/softrdp/softrdp.mk
# Keep the software rasterizer optimized in debug builds.
$(SOFTRDP_DIR)/worker_pool.o: CFLAGS += -O3
$(SOFTRDP_DIR)/worker_pool.o: $(CORE_DIR)/src/device/rcp/rdp/performance_cores.h
endif
$(CORE_DIR)/src/libretro.o: $(CORE_DIR)/src/renderer_options.h
$(CORE_DIR)/src/renderer_options.o: $(CORE_DIR)/src/renderer_options.h
$(CORE_DIR)/src/device/rcp/rdp/performance_cores.o: $(CORE_DIR)/src/device/rcp/rdp/performance_cores.h

ifeq ($(HAVE_PARALLEL_RDP),1)
PARALLEL_RDP_IMPLEMENTATION = $(CORE_DIR)/src/device/rcp/rdp/p_rdp
include $(PARALLEL_RDP_IMPLEMENTATION)/config.mk
CFLAGS += $(PARALLEL_RDP_CFLAGS) -DHAVE_PARALLEL_RDP
CXXFLAGS += $(PARALLEL_RDP_CXXFLAGS) $(PARALLEL_RDP_INCLUDE_DIRS) -DHAVE_PARALLEL_RDP -DHAVE_RENDERER_AFFINITY
INCFLAGS += -I$(PARALLEL_RDP_IMPLEMENTATION)/vulkan-headers/include
SOURCES_C += $(PARALLEL_RDP_SOURCES_C)
SOURCES_CXX += $(PARALLEL_RDP_SOURCES_CXX) $(CORE_DIR)/src/device/rcp/rdp/parallel_imp.cpp
LDFLAGS += $(PARALLEL_RDP_LDFLAGS)
$(PARALLEL_RDP_IMPLEMENTATION)/parallel-rdp/rdp_device.o: $(PARALLEL_RDP_IMPLEMENTATION)/parallel-rdp/worker_thread.hpp $(CORE_DIR)/src/device/rcp/rdp/performance_cores.h
$(PARALLEL_RDP_IMPLEMENTATION)/parallel-rdp/command_ring.o: $(CORE_DIR)/src/device/rcp/rdp/performance_cores.h
$(CORE_DIR)/src/device/rcp/rdp/parallel_imp.o: $(CORE_DIR)/src/renderer_options.h $(CORE_DIR)/src/device/rcp/rdp/performance_cores.h
endif

GLRDP_DIR = $(CORE_DIR)/src/device/rcp/rdp/glrdp
ifneq (,$(filter 1,$(HAVE_GLRDP) $(HAVE_GL2_RDP) $(HAVE_GLES2_RDP) $(HAVE_D3D9)))
# FramebufferManager's storage interface is shared by modern and legacy devices.
SOURCES_CXX += $(addprefix $(GLRDP_DIR)/,gl_loader.cpp framebuffer_manager.cpp rdp_parser.cpp rdp_tmem.cpp)
$(addprefix $(GLRDP_DIR)/,gl_loader.o framebuffer_manager.o rdp_parser.o rdp_tmem.o): CXXFLAGS += -std=c++20 -O3 -fno-fast-math
endif

ifneq (,$(filter 1,$(HAVE_GL2_RDP) $(HAVE_GLES2_RDP) $(HAVE_D3D9)))
LEGACY_GPU_DIR = $(CORE_DIR)/src/device/rcp/rdp/legacygpu
SOURCES_CXX += $(addprefix $(LEGACY_GPU_DIR)/,libretro_legacy.cpp raster_renderer.cpp raster_shaders.cpp legacy_shaders.cpp)
COREFLAGS += -DHAVE_LEGACY_GPU
ifeq ($(HAVE_GL2_RDP),1)
SOURCES_CXX += $(LEGACY_GPU_DIR)/gl2_gpu.cpp
COREFLAGS += -DHAVE_GL2_RDP
ifneq (,$(findstring win,$(platform)))
LDFLAGS += -lopengl32
else
LDFLAGS += $(GL_LIB)
endif
endif
ifeq ($(HAVE_GLES2_RDP),1)
SOURCES_CXX += $(LEGACY_GPU_DIR)/gles2_gpu.cpp
COREFLAGS += -DHAVE_GLES2_RDP
# GLES symbols are resolved through the frontend; no desktop GL linkage needed.
endif
ifeq ($(HAVE_D3D9),1)
SOURCES_CXX += $(LEGACY_GPU_DIR)/d3d9_gpu.cpp
COREFLAGS += -DHAVE_D3D9
endif
$(addprefix $(LEGACY_GPU_DIR)/,libretro_legacy.o raster_renderer.o raster_shaders.o legacy_shaders.o gl2_gpu.o gles2_gpu.o d3d9_gpu.o): CXXFLAGS += -std=c++20 -O3 -fno-fast-math
endif

ifeq ($(HAVE_GLRDP),1)
SOURCES_CXX += $(addprefix $(GLRDP_DIR)/,libretro_glrdp.cpp gl_state_guard.cpp rdp_renderer.cpp)
COREFLAGS += -DHAVE_GLRDP
ifneq (,$(filter 1,$(GLES) $(GLES3) $(FORCE_GLES) $(FORCE_GLES3)))
COREFLAGS += -DGLRDP_DEFAULT_GLES3
endif
# Only GLRDP needs C++20; other renderers retain C++17.
$(addprefix $(GLRDP_DIR)/,libretro_glrdp.o gl_loader.o gl_state_guard.o framebuffer_manager.o rdp_parser.o rdp_tmem.o rdp_renderer.o): CXXFLAGS += -std=c++20 -O3 -fno-fast-math
endif

# Shared ROM/PIF fingerprint implementation.
SOURCES_CXX += $(filter %.cpp,$(SOURCES_USF))
SOURCES_C += $(filter %.c,$(SOURCES_USF))
$(CORE_DIR)/src/usf/usf.o: CXXFLAGS += -fno-fast-math
SOURCES_C += $(LIBRETRO_COMM_DIR)/utils/md5.c


ifneq (,$(findstring win,$(platform)))
	SOURCES_C += $(ROOT_DIR)/deps/mman/sys/mman.c
else
endif

# Libretro
SOURCES_C += $(ROOT_DIR)/src/libretro.c \
	$(LIBRETRO_COMM_DIR)/memmap/memalign.c \
	$(ROOT_DIR)/src/core/input.c \
	$(LIBRETRO_COMM_DIR)/audio/resampler/drivers/sinc_resampler.c \
	$(LIBRETRO_COMM_DIR)/audio/resampler/drivers/nearest_resampler.c \
	$(LIBRETRO_COMM_DIR)/audio/resampler/audio_resampler.c \
	$(ROOT_DIR)/src/core/audio.c \
	$(LIBRETRO_COMM_DIR)/file/config_file.c \
	$(LIBRETRO_COMM_DIR)/file/config_file_userdata.c \
	$(LIBRETRO_COMM_DIR)/file/file_path.c \
	$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
	$(LIBRETRO_COMM_DIR)/time/rtime.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strl.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_posix_string.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strcasestr.c \
	$(LIBRETRO_COMM_DIR)/audio/conversion/float_to_s16.c \
	$(LIBRETRO_COMM_DIR)/audio/conversion/s16_to_float.c \
	$(LIBRETRO_COMM_DIR)/features/features_cpu.c \
	$(LIBRETRO_COMM_DIR)/lists/string_list.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_utf.c \
	$(LIBRETRO_COMM_DIR)/string/stdstring.c \
	$(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c \
	$(LIBRETRO_COMM_DIR)/streams/file_stream.c \
	$(LIBRETRO_COMM_DIR)/streams/file_stream_transforms.c \
	$(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \


	PARALLEL_RSP_ARCH := simd
	SOURCES_CXX += $(RSPDIR_PARALLEL)/parallel.cpp \
				   $(RSPDIR_PARALLEL)/rsp_disasm.cpp \
				   $(RSPDIR_PARALLEL)/jit_allocator.cpp \
				   $(wildcard $(RSPDIR_PARALLEL)/rsp/*.cpp) \
				   $(wildcard $(RSPDIR_PARALLEL)/arch/$(PARALLEL_RSP_ARCH)/rsp/*.cpp)
ifeq ($(RSP_BACKEND),interpreter)
	SOURCES_CXX += $(RSPDIR_PARALLEL)/rsp_interpreter.cpp
	COREFLAGS += -DPARALLAX_RSP_INTERPRETER
else
	SOURCES_CXX += $(RSPDIR_PARALLEL)/rsp_jit.cpp $(RSPDIR_PARALLEL)/jit_vector.cpp
ifneq (,$(filter aarch64 arm64,$(ARCH)))
	INCFLAGS += -I$(ROOT_DIR)/deps/xbyak_aarch64 -I$(ROOT_DIR)/deps/xbyak_aarch64/xbyak_aarch64
	SOURCES_CXX += $(filter-out $(PARALLAXJIT_SOURCE),$(ROOT_DIR)/deps/xbyak_aarch64/src/xbyak_aarch64_impl.cpp)
else
	INCFLAGS += -I$(ROOT_DIR)/deps/xbyak
endif
endif

	CXXFLAGS += -I$(RSPDIR_PARALLEL)/arch/$(PARALLEL_RSP_ARCH)/rsp
	CFLAGS += -DHAVE_PARALLEL_RSP -DPARALLEL_INTEGRATION
	CXXFLAGS += -DHAVE_PARALLEL_RSP -DPARALLEL_INTEGRATION

ifeq ($(HAVE_NEON),1)
	SOURCES_ASM += $(LIBRETRO_COMM_DIR)/audio/conversion/float_to_s16_neon.S \
						$(LIBRETRO_COMM_DIR)/audio/conversion/s16_to_float_neon.S \
						$(LIBRETRO_COMM_DIR)/audio/resampler/drivers/sinc_resampler_neon.S
endif

ifeq ($(DYNAREC_USED),1)
ifneq ($(PARALLAXJIT_DIR),)
SOURCES_CXX += $(PARALLAXJIT_SOURCE)
endif
endif
