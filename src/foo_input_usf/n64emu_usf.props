<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Fb2kSDKRoot Condition="'$(Fb2kSDKRoot)' == ''">$(MSBuildThisFileDirectory)..\..\deps\fb2k</Fb2kSDKRoot>
    <Fb2kLibraryDir Condition="'$(Fb2kLibraryDir)' == ''">$(Fb2kSDKRoot)\lib\$(Platform)\$(Configuration)</Fb2kLibraryDir>
    <WTLIncludeDir Condition="'$(WTLIncludeDir)' == ''">$(Fb2kSDKRoot)\wtl\include</WTLIncludeDir>
    <N64emuUSFRoot Condition="'$(N64emuUSFRoot)' == ''">$(MSBuildThisFileDirectory)..\..</N64emuUSFRoot>
    <N64emuUSFDirectory Condition="'$(N64emuUSFDirectory)' == ''">$(N64emuUSFRoot)\build\usf\$(Platform)</N64emuUSFDirectory>
    <N64emuUSFImportLibrary>$(IntDir)n64emu_usf.lib</N64emuUSFImportLibrary>
    <N64emuUSFMachine Condition="'$(Platform)' == 'Win32'">X86</N64emuUSFMachine>
    <N64emuUSFMachine Condition="'$(N64emuUSFMachine)' == ''">$(Platform)</N64emuUSFMachine>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(N64emuUSFRoot)\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(Fb2kLibraryDir);$(N64emuUSFDirectory);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(N64emuUSFImportLibrary);delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>n64emu_usf.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)n64emu_usf_delay.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <Target Name="CheckN64emuUSF" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(Fb2kSDKRoot)\foobar2000\SDK\foobar2000.h') or !Exists('$(Fb2kSDKRoot)\pfc\pfc.h') or !Exists('$(Fb2kSDKRoot)\libPPUI\gdiplus_helpers.h')"
           Text="Supply the foobar2000 SDK (foobar2000, pfc and libPPUI folders) using Fb2kSDKRoot. SDK sources are not bundled." />
    <Error Condition="!Exists('$(WTLIncludeDir)\atlapp.h')" Text="Supply WTL headers using WTLIncludeDir." />
    <Error Condition="!Exists('$(Fb2kLibraryDir)\foobar2000_sdk.lib') or !Exists('$(Fb2kLibraryDir)\foobar2000_component_client.lib') or !Exists('$(Fb2kLibraryDir)\pfc.lib') or !Exists('$(Fb2kLibraryDir)\libppui.lib')"
           Text="Build the matching foobar2000 SDK libraries and set Fb2kLibraryDir to their directory." />
    <Error Condition="!Exists('$(N64emuUSFRoot)\src\usf\usf.h')"
           Text="USF headers are missing from $(N64emuUSFRoot). Set N64emuUSFRoot to the n64emu source checkout." />
    <Error Condition="!Exists('$(N64emuUSFDirectory)\n64emu_usf.def') or !Exists('$(N64emuUSFDirectory)\n64emu_usf.dll')"
           Text="Build the $(Platform) n64emu USF player DLL and .def into $(N64emuUSFDirectory)." />
  </Target>
  <Target Name="BuildN64emuUSFImportLibrary" BeforeTargets="Link"
          Inputs="$(N64emuUSFDirectory)\n64emu_usf.def;$(N64emuUSFDirectory)\n64emu_usf.dll"
          Outputs="$(N64emuUSFImportLibrary)">
    <MakeDir Directories="$(IntDir)" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; /nologo /def:&quot;$(N64emuUSFDirectory)\n64emu_usf.def&quot; /out:&quot;$(N64emuUSFImportLibrary)&quot; /name:n64emu_usf.dll /machine:$(N64emuUSFMachine)" />
  </Target>
  <Target Name="CopyN64emuUSF" AfterTargets="Build">
    <Copy SourceFiles="$(N64emuUSFDirectory)\n64emu_usf.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
