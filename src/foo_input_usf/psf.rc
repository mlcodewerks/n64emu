IDD_USF_CONFIG DIALOGEX 0, 0, 332, 288
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Length",-1,7,7,140,64
    CONTROL         "Force all songs to play indefinitely",IDC_INDEFINITE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,19,130,10
    RTEXT           "Default length is:",-1,10,36,58,8
    EDITTEXT        IDC_DLENGTH,72,34,47,12,ES_AUTOHSCROLL | ES_WANTRETURN | WS_GROUP
    LTEXT           "mm:ss",-1,121,36,25,8
    RTEXT           "Fade out for:",-1,14,52,54,8
    EDITTEXT        IDC_DFADE,72,50,47,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "mm:ss",-1,121,52,25,8
    GROUPBOX        "Sound",-1,7,75,140,47
    CONTROL         "Resample to:",IDC_RESAMPLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,86,57,10
    EDITTEXT        IDC_RESAMPLE_HZ,72,85,47,12,ES_AUTOHSCROLL | ES_WANTRETURN | WS_GROUP
    LTEXT           "Hz",-1,122,86,9,8
    CONTROL         "Suppress opening silence",IDC_SOS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,162,13,150,10
    CONTROL         "Stop after",IDC_SES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,162,27,45,10
    EDITTEXT        IDC_SILENCE,208,26,24,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "seconds of silence",-1,235,28,68,8
    CONTROL         "Use year only in ""Date"" metadata",IDC_YEAR,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,162,55,150,10
    CONTROL         "Print informational messages to console",IDC_INFO,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,162,69,150,10
    CONTROL         "",IDC_LOGO,"Static",SS_OWNERDRAW,190,86,64,64
    //CTEXT           "",IDC_URL,179,134,101,8,NOT WS_GROUP
END

IDD_TIME DIALOGEX 31, 26, 140, 44
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Edit Length"
FONT 8, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Length:",-1,7,9,25,10,0,WS_EX_RIGHT
    EDITTEXT        IDC_LENGTH,37,7,37,12,ES_AUTOHSCROLL
