<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ParallaxUSFRoot Condition="'$(ParallaxUSFRoot)' == ''">$(MSBuildThisFileDirectory)..\..</ParallaxUSFRoot>
    <ParallaxUSFDirectory Condition="'$(ParallaxUSFDirectory)' == ''">$(ParallaxUSFRoot)\build\usf\$(Platform)</ParallaxUSFDirectory>
    <N64emuUSFImportLibrary>$(IntDir)n64emu_usf.lib</N64emuUSFImportLibrary>
    <N64emuUSFMachine Condition="'$(Platform)' == 'Win32'">X86</N64emuUSFMachine>
    <N64emuUSFMachine Condition="'$(N64emuUSFMachine)' == ''">$(Platform)</N64emuUSFMachine>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ParallaxUSFRoot)\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ParallaxUSFDirectory);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(N64emuUSFImportLibrary);delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>n64emu_usf.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)parallax_usf_delay.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <Target Name="CheckParallaxUSF" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ParallaxUSFRoot)\src\usf\usf.h')"
           Text="USF headers are missing from $(ParallaxUSFRoot). Set ParallaxUSFRoot to the n64emu source checkout." />
    <Error Condition="!Exists('$(ParallaxUSFDirectory)\n64emu_usf.def') or !Exists('$(ParallaxUSFDirectory)\n64emu_usf.dll')"
           Text="Build the $(Platform) n64emu USF player DLL and .def into $(ParallaxUSFDirectory)." />
  </Target>
  <Target Name="BuildN64emuUSFImportLibrary" BeforeTargets="Link"
          Inputs="$(ParallaxUSFDirectory)\n64emu_usf.def;$(ParallaxUSFDirectory)\n64emu_usf.dll"
          Outputs="$(N64emuUSFImportLibrary)">
    <MakeDir Directories="$(IntDir)" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; /nologo /def:&quot;$(ParallaxUSFDirectory)\n64emu_usf.def&quot; /out:&quot;$(N64emuUSFImportLibrary)&quot; /name:n64emu_usf.dll /machine:$(N64emuUSFMachine)" />
  </Target>
  <Target Name="CopyParallaxUSF" AfterTargets="Build">
    <Copy SourceFiles="$(ParallaxUSFDirectory)\n64emu_usf.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
