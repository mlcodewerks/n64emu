<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Usen64emuUSF Condition="'$(Usen64emuUSF)' == '' and ('$(Platform)' == 'Win32' or '$(Platform)' == 'x64')">true</Usen64emuUSF>
    <Usen64emuUSF Condition="'$(Usen64emuUSF)' == ''">false</Usen64emuUSF>
    <n64emuUSFRoot Condition="'$(n64emuUSFRoot)' == ''">@N64EMU_ROOT@</n64emuUSFRoot>
    <n64emuUSFDirectory Condition="'$(n64emuUSFDirectory)' == ''">$(n64emuUSFRoot)\build\usf\$(Platform)</n64emuUSFDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Usen64emuUSF)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>N64EMU_USF_COMPONENT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(n64emuUSFDirectory);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>n64emu_usf.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>n64emu_usf.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(Usen64emuUSF)' == 'true'">
    <ClCompile Include="$(MSBuildThisFileDirectory)n64emu_usf_delay.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <Target Name="Checkn64emuUSF" BeforeTargets="PrepareForBuild" Condition="'$(Usen64emuUSF)' == 'true'">
    <Error Condition="!Exists('$(n64emuUSFDirectory)\n64emu_usf.lib') or !Exists('$(n64emuUSFDirectory)\n64emu_usf.dll')"
           Text="Build the $(Platform) n64emu USF DLL, then run tools/build_usf_import_library.ps1 -Architecture $(Platform) -BuildDirectory &quot;$(n64emuUSFDirectory)&quot; to generate its MSVC import library, or set Usen64emuUSF=false to build lazyusf2." />
  </Target>
  <Target Name="Copyn64emuUSF" AfterTargets="Build" Condition="'$(Usen64emuUSF)' == 'true'">
    <Copy SourceFiles="$(n64emuUSFDirectory)\n64emu_usf.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
